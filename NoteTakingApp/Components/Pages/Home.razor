@page "/"
@using NoteTakingApp.Models
@using NoteTakingApp.Services.Interfaces
@inject INoteService NoteService
@inject NavigationManager Navigation

<PageTitle>Dashboard - NoteTaking App</PageTitle>

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-4">
                        <i class="bi bi-house-door text-primary"></i>
                        Dashboard
                    </h1>
                    <p class="lead text-muted">Welcome back! Here's an overview of your notes.</p>
                </div>
                <div>
                    <a href="/note/create" class="btn btn-primary btn-lg">
                        <i class="bi bi-plus-circle"></i> New Note
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="row">
            <div class="col-12 text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted">Loading dashboard...</p>
            </div>
        </div>
    }
    else
    {
        <!-- Statistics Cards -->
        <div class="row mb-4">
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card border-primary">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="card-title text-primary">@totalNotes</h4>
                                <p class="card-text text-muted mb-0">Total Notes</p>
                            </div>
                            <div class="text-primary">
                                <i class="bi bi-journal-text display-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card border-success">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="card-title text-success">@totalWords</h4>
                                <p class="card-text text-muted mb-0">Total Words</p>
                            </div>
                            <div class="text-success">
                                <i class="bi bi-fonts display-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card border-info">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="card-title text-info">@averageWordsPerNote</h4>
                                <p class="card-text text-muted mb-0">Avg Words/Note</p>
                            </div>
                            <div class="text-info">
                                <i class="bi bi-bar-chart display-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card border-warning">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="card-title text-warning">@notesWithHeaders</h4>
                                <p class="card-text text-muted mb-0">With Headers</p>
                            </div>
                            <div class="text-warning">
                                <i class="bi bi-hash display-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Notes and Quick Actions -->
        <div class="row">
            <!-- Recent Notes -->
            <div class="col-lg-8 mb-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-clock-history text-primary"></i>
                            Recent Notes
                        </h5>
                        <a href="/notes" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-arrow-right"></i> View All
                        </a>
                    </div>
                    <div class="card-body">
                        @if (recentNotes.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var note in recentNotes.Take(5))
                                {
                                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-start border-0 px-0"
                                         @onclick="() => NavigateToNote(note.FileName)"
                                         style="cursor: pointer;">
                                        <div class="flex-grow-1">
                                            <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                                                <h6 class="mb-1 text-truncate" style="max-width: 300px;">
                                                    @if (note.HasH1Header)
                                                    {
                                                        <i class="bi bi-hash text-primary me-1"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-file-earmark-text text-muted me-1"></i>
                                                    }
                                                    @note.DisplayTitle
                                                </h6>
                                                <small class="text-muted">@note.WordCount words</small>
                                            </div>
                                            <p class="mb-1 text-muted">@GetPreviewText(note.Content, 100)</p>
                                            <small class="text-muted">@note.FileName</small>
                                        </div>
                                        <div class="ms-2">
                                            <i class="bi bi-chevron-right text-muted"></i>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-journal-plus display-4 text-muted"></i>
                                <p class="text-muted mt-2">No notes yet. Create your first note to get started!</p>
                                <a href="/note/create" class="btn btn-primary">
                                    <i class="bi bi-plus-circle"></i> Create Note
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Quick Actions & Stats -->
            <div class="col-lg-4 mb-4">
                <!-- Quick Actions -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-lightning text-warning"></i>
                            Quick Actions
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a href="/note/create" class="btn btn-primary">
                                <i class="bi bi-plus-circle me-2"></i>
                                Create New Note
                            </a>
                            <a href="/notes" class="btn btn-outline-secondary">
                                <i class="bi bi-journal-text me-2"></i>
                                Browse All Notes
                            </a>
                            <button class="btn btn-outline-info" @onclick="RefreshDashboard">
                                <i class="bi bi-arrow-clockwise me-2"></i>
                                Refresh Dashboard
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Top Notes by Word Count -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-trophy text-success"></i>
                            Longest Notes
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (topNotesByWords.Any())
                        {
                            @foreach (var note in topNotesByWords.Take(3))
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded bg-light">
                                    <div class="flex-grow-1" @onclick="() => NavigateToNote(note.FileName)" style="cursor: pointer;">
                                        <div class="fw-bold text-truncate" style="max-width: 200px;" title="@note.DisplayTitle">
                                            @note.DisplayTitle
                                        </div>
                                        <small class="text-muted">@note.FileName</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-primary">@note.WordCount</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center">No notes available</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Markdown Syntax Quick Reference -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-info-circle text-info"></i>
                            Markdown Quick Reference
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <h6>Headers</h6>
                                <code># H1</code><br>
                                <code>## H2</code><br>
                                <code>### H3</code>
                            </div>
                            <div class="col-md-4">
                                <h6>Formatting</h6>
                                <code>**bold**</code><br>
                                <code>*italic*</code><br>
                                <code>`code`</code>
                            </div>
                            <div class="col-md-4">
                                <h6>Lists & Links</h6>
                                <code>- List item</code><br>
                                <code>1. Numbered</code><br>
                                <code>[link](url)</code>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="row mt-3">
            <div class="col-12">
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i>
                    @errorMessage
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Dictionary<string, NoteMetadata> notes = new();
    private List<NoteMetadata> recentNotes = new();
    private List<NoteMetadata> topNotesByWords = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    // Statistics
    private int totalNotes = 0;
    private int totalWords = 0;
    private int averageWordsPerNote = 0;
    private int notesWithHeaders = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            notes = await NoteService.LoadNoteAsync();

            CalculateStatistics();
            PrepareNoteCollections();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load dashboard data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateStatistics()
    {
        var noteList = notes.Values.ToList();

        totalNotes = noteList.Count;
        totalWords = noteList.Sum(n => n.WordCount);
        averageWordsPerNote = totalNotes > 0 ? totalWords / totalNotes : 0;
        notesWithHeaders = noteList.Count(n => n.HasH1Header);
    }

    private void PrepareNoteCollections()
    {
        var noteList = notes.Values.ToList();

        // Sort by filename (which should correlate with creation time)
        recentNotes = noteList
            .OrderByDescending(n => n.FileName)
            .ToList();

        // Top notes by word count
        topNotesByWords = noteList
            .Where(n => n.WordCount > 0)
            .OrderByDescending(n => n.WordCount)
            .ToList();
    }

    private async Task RefreshDashboard()
    {
        await LoadDashboardDataAsync();
        StateHasChanged();
    }

    private void NavigateToNote(string fileName)
    {
        Navigation.NavigateTo($"/note/edit/{fileName}");
    }

    private string GetPreviewText(string content, int maxLength = 150)
    {
        if (string.IsNullOrWhiteSpace(content)) return "Empty note...";

        // Remove markdown syntax for preview
        var preview = content
            .Replace("#", "")
            .Replace("*", "")
            .Replace("`", "")
            .Replace("\n", " ")
            .Trim();

        return preview.Length > maxLength ? preview.Substring(0, maxLength) + "..." : preview;
    }
}