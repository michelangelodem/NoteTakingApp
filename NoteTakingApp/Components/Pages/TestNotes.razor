@page "/test-notes"
@using NoteTakingApp.Models
@using NoteTakingApp.Services.Commands

<style>
    .test-notes-container {
        max-width: 700px;
        margin: 2rem auto;
        background: #f8f9fa;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.07);
        padding: 2rem;
    }

    .test-notes-form label {
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .test-notes-form input, .test-notes-form textarea {
        margin-bottom: 1rem;
        width: 100%;
    }

    .test-notes-actions {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .test-notes-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 2rem;
    }

        .test-notes-table th, .test-notes-table td {
            border: 1px solid #dee2e6;
            padding: 0.5rem 1rem;
            text-align: left;
        }

        .test-notes-table th {
            background: #e9ecef;
        }

    .alert-success {
        margin-top: 1rem;
    }
</style>

<div class="test-notes-container">
    <h2>Test Notes</h2>
    <div class="test-notes-form">
        <label for="title">Title</label>
        <input id="title" @bind="_title" placeholder="Title" class="form-control" />

        <label for="content">Content</label>
        <textarea id="content" @bind="_content" placeholder="Content" class="form-control" rows="4"></textarea>
    </div>
    <div class="test-notes-actions">
        <button class="btn btn-primary" @onclick="CreateNote">Create Note</button>
        <button class="btn btn-secondary" @onclick="LoadNotes">Load Notes</button>
    </div>

    @if (_createdNote != null)
    {
        <div class="alert alert-success">
            <strong>Note Created!</strong><br />
            <b>FileName:</b> @_createdNote.FileName<br />
            <b>DisplayTitle:</b> @_createdNote.DisplayTitle<br />
            <b>Content:</b> <pre>@_createdNote.Content</pre>
        </div>
    }

    @if (_loadedNotes != null && _loadedNotes.Count > 0)
    {
        <h4 class="mt-4">Loaded Notes</h4>
        <table class="test-notes-table">
            <thead>
                <tr>
                    <th>FileName</th>
                    <th>DisplayTitle</th>
                    <th>Content</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var note in _loadedNotes.Values)
                {
                    <tr>
                        <td>@note.FileName</td>
                        <td>@note.DisplayTitle</td>
                        <td>
                            @if (_editingNoteTitle == note.FileNameWithoutExtension)
                            {
                                <textarea class="form-control" rows="4" @bind="_editContent"></textarea>
                            }
                            else
                            {
                                <pre style="white-space: pre-wrap; max-width: 300px;">@note.Content</pre>
                            }
                        </td>
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteNote(note.FileNameWithoutExtension)">Delete</button>
                            @if (_editingNoteTitle == note.FileNameWithoutExtension)
                            {
                                <button class="btn btn-primary btn-sm" @onclick="() => SaveEdit(note)">Save</button>
                                <button class="btn btn-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm" @onclick="() => StartEditing(note)">Edit</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (_loadedNotes == null || _loadedNotes.Count == 0)
    {
        <div class="alert alert-info">No notes loaded.</div>
    }
</div>

@code {
    private string _title = "";
    private string _content = "";
    private readonly Configurations.NotesConfiguration _notesConfiguration = new Configurations.NotesConfiguration();
    private NoteMetadata? _createdNote;
    private Dictionary<string, NoteMetadata> _loadedNotes = new();

    // Editing state
    private string? _editingNoteTitle = null;
    private string _editContent = "";

    private async Task CreateNote()
    {
        CreateNote noteCreator = new Services.Implementations.CreateNote(_notesConfiguration, _loadedNotes);
        _createdNote = await noteCreator.CreateNoteAsync(_title, _content);
    }

    private async Task LoadNotes()
    {
        _loadedNotes.Clear();
        LoadNotes noteLoader = new Services.Implementations.LoadNotes(_notesConfiguration, _loadedNotes);
        await noteLoader.LoadNotesAsync();
        StateHasChanged();
    }

    private async Task DeleteNote(string fileNameWithoutExtension)
    {
        DeleteNote noteDeleter = new Services.Implementations.DeleteNote(_notesConfiguration, _loadedNotes);
        await noteDeleter.DeleteNoteAsync(fileNameWithoutExtension);
        _createdNote = null;
        StateHasChanged();
    }

    private void StartEditing(NoteMetadata note)
    {
        _editingNoteTitle = note.FileNameWithoutExtension;
        _editContent = note.Content;
    }

    private void CancelEdit()
    {
        _editingNoteTitle = null;
        _editContent = "";
    }

    private async Task SaveEdit(NoteMetadata note)
    {
        EditNote noteEditor = new Services.Implementations.EditNote(_notesConfiguration, _loadedNotes);
        var updatedNote = await noteEditor.EditNoteAsync(note, _editContent);
        if (updatedNote != null)
        {
            _loadedNotes[note.FileNameWithoutExtension] = updatedNote;
        }
        _editingNoteTitle = null;
        _editContent = "";
        StateHasChanged();
    }
}