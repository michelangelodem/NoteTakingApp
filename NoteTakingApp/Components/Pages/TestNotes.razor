@page "/test-notes"
@using NoteTakingApp.Models
@using NoteTakingApp.Services.Interfaces
@using NoteTakingApp.Services.Implementations

@inject IServiceProvider ServiceProvider

<style>
    .test-notes-container {
        max-width: 700px;
        margin: 2rem auto;
        background: #f8f9fa;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.07);
        padding: 2rem;
    }

    .test-notes-form label {
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .test-notes-form input, .test-notes-form textarea {
        margin-bottom: 1rem;
        width: 100%;
    }

    .test-notes-actions {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .test-notes-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 2rem;
    }

        .test-notes-table th, .test-notes-table td {
            border: 1px solid #dee2e6;
            padding: 0.5rem 1rem;
            text-align: left;
        }

        .test-notes-table th {
            background: #e9ecef;
        }

    .alert-success {
        margin-top: 1rem;
    }

    .alert-danger {
        margin-top: 1rem;
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        color: #721c24;
        padding: 1rem;
        border-radius: 0.25rem;
    }

    .alert-info {
        margin-top: 1rem;
        background-color: #d1ecf1;
        border: 1px solid #bee5eb;
        color: #0c5460;
        padding: 1rem;
        border-radius: 0.25rem;
    }
</style>

<div class="test-notes-container">
    <h2>Test INoteService & NoteServices Implementation</h2>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @_errorMessage
        </div>
    }

    <div class="test-notes-form">
        <label for="title">Title (optional)</label>
        <input id="title" @bind="_title" placeholder="Optional: Enter title or leave blank to use H1 from content" class="form-control" />

        <label for="content">Content</label>
        <textarea id="content" @bind="_content" placeholder="Enter note content. Use # Title for H1 header." class="form-control" rows="6"></textarea>
    </div>

    <div class="test-notes-actions">
        <button class="btn btn-primary" @onclick="CreateNote" disabled="@_isLoading">
            @if (_isLoading && _currentOperation == "create")
            {
                <span>Creating...</span>
            }
            else
            {
                <span>Create Note</span>
            }
        </button>
        <button class="btn btn-secondary" @onclick="LoadNotes" disabled="@_isLoading">
            @if (_isLoading && _currentOperation == "load")
            {
                <span>Loading...</span>
            }
            else
            {
                <span>Load All Notes</span>
            }
        </button>
        <button class="btn btn-info" @onclick="ClearResults">Clear Results</button>
    </div>

    @if (_createdNote != null)
    {
        <div class="alert alert-success">
            <strong>Note Created Successfully!</strong><br />
            <b>FileName:</b> @_createdNote.FileName<br />
            <b>DisplayTitle:</b> @_createdNote.DisplayTitle<br />
            <b>WordCount:</b> @_createdNote.WordCount<br />
            <b>CreatedDate:</b> @_createdNote.CreatedDate<br />
            <b>LastModifiedDate:</b> @_createdNote.LastModifiedDate<br />
            <b>Content Preview:</b><br />
            <pre style="background: #f8f9fa; padding: 0.5rem; border-radius: 0.25rem;">@(_createdNote.Content.Length > 200 ? _createdNote.Content.Substring(0, 200) + "..." : _createdNote.Content)</pre>
        </div>
    }

    @if (_loadedNotes != null && _loadedNotes.Any())
    {
        <h4 class="mt-4">Loaded Notes (@_loadedNotes.Count() notes)</h4>
        <table class="test-notes-table">
            <thead>
                <tr>
                    <th>FileName</th>
                    <th>DisplayTitle</th>
                    <th>WordCount</th>
                    <th>HasH1</th>
                    <th>Created</th>
                    <th>Modified</th>
                    <th>Content Preview</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var note in _loadedNotes.Values)
                {
                    <tr>
                        <td>@note.FileName</td>
                        <td>@note.DisplayTitle</td>
                        <td>@note.WordCount</td>
                        <td>@(note.HasH1Header ? "Yes" : "No")</td>
                        <td>@note.CreatedDate.ToString("yyyy-MM-dd")</td>
                        <td>@note.LastModifiedDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (_editingNoteId == note.FileNameWithoutExtension)
                            {
                                <textarea class="form-control" rows="4" @bind="_editContent" style="min-width: 300px;"></textarea>
                            }
                            else
                            {
                                <pre style="white-space: pre-wrap; max-width: 300px; max-height: 100px; overflow-y: auto; font-size: 0.85em;">@(note.Content.Length > 150 ? note.Content.Substring(0, 150) + "..." : note.Content)</pre>
                            }
                        </td>
                        <td>
                            <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                                @if (_editingNoteId == note.FileNameWithoutExtension)
                                {
                                    <button class="btn btn-success btn-sm" @onclick="() => SaveEdit(note)" disabled="@_isLoading">
                                        @if (_isLoading && _currentOperation == "edit")
                                        {
                                            <span>Saving...</span>
                                        }
                                        else
                                        {
                                            <span>Save</span>
                                        }
                                    </button>
                                    <button class="btn btn-secondary btn-sm" @onclick="CancelEdit" disabled="@_isLoading">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-primary btn-sm" @onclick="() => StartEditing(note)" disabled="@_isLoading">Edit</button>
                                }
                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteNote(note.FileNameWithoutExtension)" disabled="@_isLoading">
                                    @if (_isLoading && _currentOperation == "delete" && _currentNoteId == note.FileNameWithoutExtension)
                                    {
                                        <span>Deleting...</span>
                                    }
                                    else
                                    {
                                        <span>Delete</span>
                                    }
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (_notesLoaded && (_loadedNotes == null || !_loadedNotes.Any()))
    {
        <div class="alert alert-info">No notes found in the directory.</div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success mt-3">
            @_successMessage
        </div>
    }
</div>

@code {
    private string _title = "";
    private string _content = "";
    private INoteService _noteService;
    private NoteMetadata? _createdNote;
    private NoteMetadata? _editedNote;
    private Dictionary<string, NoteMetadata>? _loadedNotes;
    private bool _notesLoaded = false;
    private bool _isLoading = false;
    private string _currentOperation = "";
    private string _currentNoteId = "";
    private string _errorMessage = "";
    private string _successMessage = "";

    // Editing state
    private string? _editingNoteId = null;
    private string _editContent = "";

    protected override void OnInitialized()
    {
        // Use DI if available, otherwise fallback to direct instantiation
        _noteService = ServiceProvider.GetService(typeof(INoteService)) as INoteService ?? new NoteServices();
    }

    private async Task CreateNote()
    {
        _errorMessage = "";
        _successMessage = "";
        _isLoading = true;
        _currentOperation = "create";

        try
        {
            string contentToCreate = _content;
            if (!string.IsNullOrWhiteSpace(_title) && !_content.TrimStart().StartsWith("# "))
            {
                contentToCreate = $"# {_title}\n\n{_content}";
            }
            else if (string.IsNullOrWhiteSpace(contentToCreate))
            {
                contentToCreate = string.IsNullOrWhiteSpace(_title) ? "# Untitled Note\n\n" : $"# {_title}\n\n";
            }

            _createdNote = await _noteService.CreateNoteAsync(contentToCreate);
            _successMessage = "Note created successfully!";
            _title = "";
            _content = "";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to create note: {ex.Message}";
            _createdNote = null;
        }
        finally
        {
            _isLoading = false;
            _currentOperation = "";
            StateHasChanged();
        }
    }

    private async Task LoadNotes()
    {
        _errorMessage = "";
        _successMessage = "";
        _isLoading = true;
        _currentOperation = "load";

        try
        {
            _loadedNotes = await _noteService.LoadNoteAsync();
            _notesLoaded = true;
            _successMessage = $"Loaded {_loadedNotes.Count()} notes successfully!";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load notes: {ex.Message}";
            _loadedNotes = null;
        }
        finally
        {
            _isLoading = false;
            _currentOperation = "";
            StateHasChanged();
        }
    }

    private async Task DeleteNote(string fileNameWithoutExtension)
    {
        _errorMessage = "";
        _successMessage = "";
        _isLoading = true;
        _currentOperation = "delete";
        _currentNoteId = fileNameWithoutExtension;

        try
        {
            var noteToDelete = _loadedNotes[fileNameWithoutExtension];
            if (noteToDelete != null)
            {
                await _noteService.DeleteNoteAsync(noteToDelete.FileName);
                _successMessage = $"Note '{noteToDelete.DisplayTitle}' deleted successfully!";
                await LoadNotes();
            }
            else
            {
                _errorMessage = "Note not found for deletion.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to delete note: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            _currentOperation = "";
            _currentNoteId = "";
            StateHasChanged();
        }
    }

    private void StartEditing(NoteMetadata note)
    {
        _editingNoteId = note.FileNameWithoutExtension;
        _editContent = note.Content;
        _errorMessage = "";
        _successMessage = "";
    }

    private void CancelEdit()
    {
        _editingNoteId = null;
        _editContent = "";
        _errorMessage = "";
        _successMessage = "";
    }

    private async Task SaveEdit(NoteMetadata note)
    {
        _errorMessage = "";
        _successMessage = "";
        _isLoading = true;
        _currentOperation = "edit";

        try
        {
            _editedNote = await _noteService.EditNoteAsync(note.FileName, _editContent);
            _successMessage = $"Note updated successfully!";
            await LoadNotes();
            _editingNoteId = null;
            _editContent = "";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to update note: {ex.Message}";
			_editedNote = null;
        }
        finally
        {
            _isLoading = false;
            _currentOperation = "";
            StateHasChanged();
        }
    }

    private void ClearResults()
    {
        _createdNote = null;
        _loadedNotes = null;
        _notesLoaded = false;
        _errorMessage = "";
        _successMessage = "";
        _editingNoteId = null;
        _editContent = "";
        StateHasChanged();
    }
}