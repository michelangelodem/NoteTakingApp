		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		line-height: 1.4;
	}

	.note-item.selected .note-preview {
		color: rgba(255, 255, 255, 0.8);
	}

	.note-date {
		font-size: 11px;
		color: #888;
	}

	.note-item.selected .note-date {
		color: rgba(255, 255, 255, 0.7);
	}

	.notes-editor {
		flex: 1;
		background: #1e1e1e;
		display: flex;
