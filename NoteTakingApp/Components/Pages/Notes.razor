@page "/notes"
@using System.Text.RegularExpressions
@using Humanizer
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using NoteTakingApp.Services.Interfaces
@using NoteTakingApp.Models
@inject INoteService NoteService

<PageTitle>All Notes - NoteTaking App</PageTitle>

<div class="container-fluid">
	<div class="row mb-4">
		<div class="col-12">
			<div class="d-flex justify-content-between align-items-center">
				<h1>
					<i class="bi bi-list-nested text-primary"></i>
					All Notes
				</h1>
				<a href="note/create" class="btn btn-primary">
					<i class="bi bi-plus-circle"></i> Create New Note
				</a>
			</div>
		</div>
	</div>

	@if (isLoading)
	{
		<div class="row">
			<div class="col-12 text-center">
				<div class="spinner-border text-primary" role="status">
					<span class="visually-hidden">Loading...</span>
				</div>
				<p class="mt-2">Loading notes...</p>
			</div>
		</div>
	}
	else if (notes != null && notes.Any())
	{
		<div class="row mb-3">
			<div class="col-12">
				<div class="input-group">
					<span class="input-group-text">
						<i class="bi bi-search"></i>
					</span>
					<input type="text" class="form-control" placeholder="Search notes..." 
					       @bind="searchTerm" @oninput="OnSearchInput" />
				</div>
			</div>
		</div>

		<div class="row mb-3">
			<div class="col-12">
				<div class="d-flex align-items-center gap-3">
					<span class="text-muted">Sort by:</span>
					<select class="form-select" style="width: auto;" @bind="sortOption">
						<option value="title">Title</option>
						<option value="wordcount">Word Count</option>
					</select>
					<button class="btn btn-outline-secondary btn-sm" @onclick="ToggleSortDirection">
						@if (sortAscending)
						{
							<i class="bi bi-sort-alpha-down"></i>
						}
						else
						{
							<i class="bi bi-sort-alpha-up"></i>
						}
					</button>
				</div>
			</div>
		</div>

		<div class="row">
			@foreach (var note in filteredNotes)
			{
				<div class="col-md-6 col-lg-4 mb-4">
					<div class="card h-100 shadow-sm">
						<div class="card-body">
							<h5 class="card-title">
								@if (note.HasH1Header)
								{
									<i class="bi bi-hash text-primary"></i>
								}
								else
								{
									<i class="bi bi-file-text text-secondary"></i>
								}
								@Regex.Replace(note.DisplayTitle, @"^\s*#+\s*", "");
							</h5>
							<p class="card-text">
								<small class="text-muted">
									<i class="bi bi-body-text"></i> @note.WordCount words
								</small>
							</p>
							<div class="mt-auto">
								<div class="d-flex gap-2">
									<a href="@($"note/edit/{note.FileName}")" class="btn btn-sm btn-primary">
										<i class="bi bi-pencil"></i> Edit
									</a>
									<button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteNote(note.FileName)">
										<i class="bi bi-trash"></i> Delete
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			}
		</div>

		@if (!filteredNotes.Any() && !string.IsNullOrEmpty(searchTerm))
		{
			<div class="row">
				<div class="col-12 text-center">
					<p class="text-muted">No notes found matching "@searchTerm"</p>
				</div>
			</div>
		}
	}
	else
	{
		<div class="row">
			<div class="col-12 text-center">
				<div class="py-5">
					<i class="bi bi-journal-x display-1 text-muted"></i>
					<h3 class="text-muted">No notes yet</h3>
					<p class="text-muted">Create your first note to get started!</p>
					<a href="note/create" class="btn btn-primary">
						<i class="bi bi-plus-circle"></i> Create First Note
					</a>
				</div>
			</div>
		</div>
	}
</div>
@if (!string.IsNullOrEmpty(errorMessage))
{
	<div class="alert alert-danger" role="alert">
		@errorMessage
	</div>
}

@code {

    private List<NoteMetadata>? notes;
    private List<NoteMetadata> filteredNotes = new();
    private bool isLoading = true;
    private string searchTerm = string.Empty;
	private string errorMessage = string.Empty;

    private string sortOptionBacking = "modified";
    private string sortOption
    {
        get => sortOptionBacking;
        set
        {
            if (sortOptionBacking != value)
            {
                sortOptionBacking = value;
                SortNotes();
            }
        }
	}

    private bool sortAscending = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotes();
    }

    private async Task LoadNotes()
    {
        try
        {
            isLoading = true;
            var notesDict = await NoteService.LoadNoteAsync();
            notes = notesDict.Values.ToList();
            ApplyFiltersAndSort();
        }
		catch (Exception ex) when (ex is IOException || ex is UnauthorizedAccessException)
        {
			ShowError("Error loading notes, you have no current access");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        //Console.WriteLine($"Search term: {searchTerm}");
        ApplyFiltersAndSort();

        searchTerm = null;
    }

    private void SortNotes()
    {
        ApplyFiltersAndSort();
    }

    private void ToggleSortDirection()
    {
        sortAscending = !sortAscending;
        ApplyFiltersAndSort();
    }

    private void ApplyFiltersAndSort()
    {
        if (notes == null) return;
        
        var filtered = notes.AsEnumerable();

        // Apply search filter
        if (!string.IsNullOrEmpty(searchTerm))
        {
            filtered = filtered.Where(n => 
                n.DisplayTitle.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                n.Content.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }

        // Apply sorting
        filtered = sortOption switch
        {
            "title" => sortAscending 
                ? filtered.OrderBy(n => n.DisplayTitle) 
                : filtered.OrderByDescending(n => n.DisplayTitle),
            "wordcount" => sortAscending 
                ? filtered.OrderBy(n => n.WordCount) 
                : filtered.OrderByDescending(n => n.WordCount)
        };

        filteredNotes = filtered.ToList();
        StateHasChanged();
    }

    private async Task DeleteNote(string fileName)
    {
        try
        {
            await NoteService.DeleteNoteAsync(fileName);
            await LoadNotes();
        }
        catch (Exception ex)
        {
            ShowError($"Error deleting note: {ex.Message}");
        }
    }

	private void ShowError(string message)
    {
        errorMessage = message;
        StateHasChanged();
        // Clear error after 5 seconds
        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            errorMessage = string.Empty;
            StateHasChanged();
        });
	}
}