@page "/notes"
@using NoteTakingApp.Models
@using NoteTakingApp.Services.Interfaces
@inject INoteService NoteService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>My Notes - NoteTaking App</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1>
                        <i class="bi bi-journal-text text-primary"></i>
                        My Notes
                    </h1>
                    <p class="text-muted">@notes.Count note(s) found</p>
                </div>
                <div>
                    <a href="/note/create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> New Note
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control"
                               placeholder="Search notes by title or content..."
                               @bind="searchTerm"
                               @oninput="OnSearchChanged">
                        @if (!string.IsNullOrEmpty(searchTerm))
                        {
                            <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading State -->
    @if (isLoading)
    {
        <div class="row">
            <div class="col-12 text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted">Loading your notes...</p>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i>
                    @errorMessage
                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadNotesAsync">
                        <i class="bi bi-arrow-clockwise"></i> Retry
                    </button>
                </div>
            </div>
        </div>
    }
    else if (filteredNotes.Count == 0 && !string.IsNullOrEmpty(searchTerm))
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="bi bi-search display-4 text-muted"></i>
                        <h4 class="mt-3">No notes found</h4>
                        <p class="text-muted">No notes match your search term "<strong>@searchTerm</strong>"</p>
                        <button class="btn btn-primary" @onclick="ClearSearch">
                            <i class="bi bi-x-circle"></i> Clear Search
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (notes.Count == 0)
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center">
                        <i class="bi bi-journal-plus display-4 text-muted"></i>
                        <h4 class="mt-3">No notes yet</h4>
                        <p class="text-muted">Get started by creating your first note!</p>
                        <a href="/note/create" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Create Your First Note
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Notes Grid -->
        <div class="row">
            @foreach (var note in filteredNotes.Take(displayCount))
            {
                <div class="col-xl-4 col-lg-6 col-md-12 mb-4">
                    <div class="card h-100 note-card" @onclick="() => NavigateToNote(note.FileName)">
                        <div class="card-header d-flex justify-content-between align-items-start">
                            <h5 class="card-title mb-0 text-truncate" style="max-width: 200px;" title="@note.DisplayTitle">
                                @if (note.HasH1Header)
                                {
                                    <i class="bi bi-hash text-primary me-1"></i>
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark-text text-muted me-1"></i>
                                }
                                @note.DisplayTitle
                            </h5>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        @onclick:stopPropagation="true">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" href="/note/edit/@note.FileName">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <button class="dropdown-item text-danger" @onclick="() => ConfirmDelete(note)">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="note-preview">
                                @GetPreviewText(note.Content)
                            </div>
                        </div>
                        <div class="card-footer">
                            <small class="text-muted">
                                <i class="bi bi-file-earmark"></i> @note.FileName
                                <span class="ms-3">
                                    <i class="bi bi-fonts"></i> @note.WordCount words
                                </span>
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (filteredNotes.Count > displayCount)
        {
            <div class="row">
                <div class="col-12 text-center">
                    <button class="btn btn-outline-primary" @onclick="LoadMore">
                        <i class="bi bi-arrow-down-circle"></i>
                        Load More (@(filteredNotes.Count - displayCount) remaining)
                    </button>
                </div>
            </div>
        }
    }
</div>

<!-- Delete Confirmation Modal -->
@if (noteToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle text-warning"></i>
                        Confirm Delete
                    </h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the note:</p>
                    <p><strong>"@noteToDelete.DisplayTitle"</strong></p>
                    <p class="text-muted">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteNote" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-trash"></i> Delete Note
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .note-card {
        cursor: pointer;
        transition: all 0.3s ease;
        border: 1px solid #dee2e6;
    }

        .note-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
            border-color: #007bff;
        }

    .note-preview {
        max-height: 120px;
        overflow: hidden;
        line-height: 1.5;
        color: #6c757d;
    }

    .dropdown-toggle::after {
        display: none;
    }
</style>

@code {
    private Dictionary<string, NoteMetadata> notes = new();
    private List<NoteMetadata> filteredNotes = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string searchTerm = string.Empty;
    private int displayCount = 9;
    private NoteMetadata? noteToDelete = null;
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotesAsync();
    }

    private async Task LoadNotesAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            notes = await NoteService.LoadNoteAsync();
            FilterNotes();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load notes: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        FilterNotes();
        displayCount = 9; // Reset display count when searching
    }

    private void FilterNotes()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredNotes = notes.Values.OrderByDescending(n => n.FileName).ToList();
        }
        else
        {
            var term = searchTerm.ToLower();
            filteredNotes = notes.Values
                .Where(n => n.DisplayTitle.ToLower().Contains(term) ||
                           n.Content.ToLower().Contains(term))
                .OrderByDescending(n => n.FileName)
                .ToList();
        }
        StateHasChanged();
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        FilterNotes();
    }

    private void LoadMore()
    {
        displayCount += 9;
    }

    private void NavigateToNote(string fileName)
    {
        Navigation.NavigateTo($"/note/edit/{fileName}");
    }

    private void ConfirmDelete(NoteMetadata note)
    {
        noteToDelete = note;
    }

    private void CancelDelete()
    {
        noteToDelete = null;
    }

    private async Task DeleteNote()
    {
        if (noteToDelete == null) return;

        try
        {
            isDeleting = true;
            await NoteService.DeleteNoteAsync(noteToDelete.FileName);

            notes.Remove(noteToDelete.FileNameWithoutExtension);
            FilterNotes();

            noteToDelete = null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete note: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private string GetPreviewText(string content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "Empty note...";

        // Remove markdown syntax for preview
        var preview = content
            .Replace("#", "")
            .Replace("*", "")
            .Replace("`", "")
            .Replace("\n", " ")
            .Trim();

        return preview.Length > 150 ? preview.Substring(0, 150) + "..." : preview;
    }
}