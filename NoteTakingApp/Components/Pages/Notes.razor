@page "/notes"
@using NoteTakingApp.Models
@using NoteTakingApp.Services
@using NoteTakingApp.Services.Interfaces
@inject INoteService NoteService
@inject IJSRuntime JSRuntime

<PageTitle>Notes</PageTitle>

<div class="notes-container">
	<aside class="notes-sidebar">
		<div class="sidebar-header">
			<button class="new-note-btn" @onclick="CreateNewNote">
				<span class="plus-icon">+</span>
				New Note
			</button>
		</div>

		<div class="search-container">
			<input type="text" class="search-input" placeholder="Search notes..."
				   @bind="searchTerm" @oninput="FilterNotes" />
		</div>

		<div class="notes-list-container">
			@if (filteredNotes.Any())
			{
				@foreach (var note in filteredNotes)
				{
					<div class="note-item @(SelectedNote?.Id == note.Id ? "selected" : "")"
						 @onclick="() => SelectNote(note)">
						<div class="note-title">
							@(string.IsNullOrEmpty(note.Title) ? "Untitled" : note.Title)
						</div>
						<div class="note-preview">
							@GetPreview(note.Content)
						</div>
						<div class="note-date">
							@note.UpdatedAt.ToString("MMM dd, yyyy")
						</div>
					</div>
				}
			}
			else
			{
				<div class="empty-notes">
					<p>No notes found</p>
				</div>
			}
		</div>
	</aside>

	<main class="notes-editor">
		@if (SelectedNote != null)
		{
			<div class="editor-container">
				<div class="editor-header">
					<input class="title-input"
						   @bind="SelectedNote.Title"
						   @onblur="SaveNote"
						   placeholder="Note title..." />
					<div class="editor-actions">
						<button class="action-btn save-btn" @onclick="SaveNote" title="Save">
							💾
						</button>
						<button class="action-btn delete-btn" @onclick="DeleteNote" title="Delete">
							🗑️
						</button>
					</div>
				</div>

				<textarea class="content-editor"
						  @bind="SelectedNote.Content"
						  @onblur="SaveNote"
						  placeholder="Start writing..."></textarea>

				<div class="editor-footer">
					<span class="word-count">@GetWordCount(SelectedNote.Content) words</span>
					<span class="last-modified">Last modified: @SelectedNote.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</span>
				</div>
			</div>
		}
		else
		{
			<div class="empty-editor">
				<div class="empty-state">
					<h2>📝</h2>
					<p>Select a note to start editing</p>
					<button class="create-first-note-btn" @onclick="CreateNewNote">Create your first note</button>
				</div>
			</div>
		}
	</main>
</div>

<style>
